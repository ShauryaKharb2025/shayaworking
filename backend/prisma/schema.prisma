generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  name String
  email String @unique
  avatar String?
  googleId String? @unique
  passwordHash String?
  role String @default("patient")
  phone String?
  preferredLanguage String @default("en")
  operatorId String?
  operator Operator? @relation(fields: [operatorId], references: [id])
  hospitalId String?
  hospital Hospital? @relation(fields: [hospitalId], references: [id])
  caregiverFor String[] @default([])
  medicalProfile Json @default("{}")
  isActive Boolean @default(true)
  doctorSlots DoctorSlot[]
  ambulances Ambulance[]
  trips Trip[] @relation("PatientTrips")
  triggeredTrips Trip[] @relation("TriggeredTrips")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(0)
}
model Operator {
  id String @id @default(uuid())
  name String @unique
  type String
  contactEmail String?
  contactPhone String?
  verified Boolean @default(false)
  verificationDocs String[] @default([])
  city String?
  slaMinutes Int @default(15)
  ambulances Ambulance[]
  users User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(0)
}
model Ambulance {
  id String @id @default(uuid())
  vehicleNumber String @unique
  operatorId String
  operator Operator @relation(fields: [operatorId], references: [id])
  tier String @default("BLS")
  equipment String[] @default([])
  crew Json @default("[]")
  driverId String?
  driver User? @relation(fields: [driverId], references: [id])
  status String @default("offline")
  location Json @default("{\"type\":\"Point\",\"coordinates\":[0,0]}")
  heading Float?
  lastPingAt DateTime?
  complianceVerified Boolean @default(false)
  trips Trip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(0)
  @@index([status])
  @@index([driverId])
}
model Hospital {
  id String @id @default(uuid())
  name String @unique
  address String?
  location Json @default("{\"type\":\"Point\",\"coordinates\":[0,0]}")
  specialties String[] @default([])
  bedsAvailable Int @default(0)
  erContact String?
  receivingReady Boolean @default(false)
  referrals HospitalReferral[]
  users User[]
  trips Trip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(0)
}
model CoverageZone {
  id String @id @default(uuid())
  name String @unique
  pincode String?
  center Json @default("{\"type\":\"Point\",\"coordinates\":[0,0]}")
  radiusKm Float @default(10)
  status String @default("coming_soon")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(0)
}
model Trip {
  id String @id @default(uuid())
  patientId String
  patient User @relation("PatientTrips", fields: [patientId], references: [id])
  triggeredById String?
  triggeredBy User? @relation("TriggeredTrips", fields: [triggeredById], references: [id])
  channel String @default("app")
  symptoms String[] @default([])
  requestKey String?
  requestFingerprint String?
  requestedAmbulanceTier String?
  pickupLocation Json
  address String?
  triage Json @default("{}")
  careDetails Json @default("{}")
  status String @default("requested")
  coverageState String @default("live")
  ambulanceId String?
  ambulance Ambulance? @relation(fields: [ambulanceId], references: [id])
  hospitalId String?
  hospital Hospital? @relation(fields: [hospitalId], references: [id])
  etaMinutes Float?
  etaSource String?
  dispatchedAt DateTime?
  autoDispatchAt DateTime?
  arrivedPickupAt DateTime?
  handedOffAt DateTime?
  events Json @default("[]")
  messages Json @default("[]")
  fallbackChannelUsed String?
  referrals HospitalReferral[]
  caregiverAccess CaregiverAccess[]
  observations ClinicalObservation[]
  healthReadings HealthReading[]
  doctorSlot DoctorSlot?
  journeyProjection JourneyProjection?
  maritimeIncidents MaritimeIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(0)
  @@unique([patientId, requestKey])
  @@index([patientId, createdAt])
  @@index([status, autoDispatchAt])
  @@index([hospitalId])
}
model WaitlistEntry {
  id String @id @default(uuid())
  pincodeOrArea String
  language String @default("en")
  contactPreference String @default("sms")
  contact String
  consented Boolean
  location Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(0)
  @@index([pincodeOrArea])
}

model HospitalReferral {
  id String @id @default(uuid())
  tripId String
  trip Trip @relation(fields: [tripId], references: [id])
  hospitalId String
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  status String @default("proposed")
  createdAt DateTime @default(now())
  @@index([tripId])
  @@index([hospitalId, status])
}

model CaregiverAccess {
  id String @id @default(uuid())
  tripId String
  trip Trip @relation(fields: [tripId], references: [id])
  tokenHash String @unique
  email String
  userId String?
  expiresAt DateTime
  revokedAt DateTime?
  @@index([tripId, userId])
}

model ClinicalObservation {
  id String @id @default(uuid())
  tripId String
  trip Trip @relation(fields: [tripId], references: [id])
  actorId String
  type String
  note String
  familyVisible Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([tripId, createdAt])
}

model JourneyProjection {
  tripId String @id
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fingerprint String
  coordination String
  summary Json
  updatedAt DateTime @updatedAt
}


model DoctorSlot {
  id String @id @default(uuid())
  doctorId String
  doctor User @relation(fields: [doctorId], references: [id])
  specialty String
  startsAt DateTime
  endsAt DateTime
  tripId String? @unique
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)
  @@unique([doctorId, startsAt])
  @@index([specialty, startsAt])
}

model HealthReading {
  id String @id @default(uuid())
  tripId String
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actorId String?
  source String
  values Json
  measuredAt DateTime @default(now())
  @@index([tripId, measuredAt])
}

model MaritimeIncident {
  id String @id @default(uuid())
  tripId String
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  caseAlias String
  category String
  episodeKey String @unique
  context String
  status String @default("detected")
  facts Json
  evidence Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  audit Json @default("[]")
  jobs MaritimeJob[]
  @@index([tripId, createdAt])
  @@index([status])
}

model MaritimeJob {
  id String @id @default(uuid())
  incidentId String
  incident MaritimeIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  kind String @default("recovery")
  status String @default("pending")
  caseVersion Int
  evidence Json
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leaseUntil DateTime?
  lastError String?
  startedAt DateTime?
  completedAt DateTime?
  advisory MaritimeAdvisory?
  @@unique([incidentId, kind])
  @@index([status, nextAttemptAt])
}

model MaritimeAdvisory {
  id String @id @default(uuid())
  jobId String @unique
  job MaritimeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  response Json
  source String
  reviewStatus String @default("pending")
  reviewedBy String?
  reviewedAt DateTime?
  execution Json?
  createdAt DateTime @default(now())
}

model MaritimeRuntime {
  id String @id
  requests Json @default("[]")
  failures Int @default(0)
  openUntil DateTime?
  status String @default("not_checked")
  reason String?
  checkedAt DateTime?
}
