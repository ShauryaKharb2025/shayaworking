# ====== SERVER ======
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ====== DATABASE (PostgreSQL) ======
DATABASE_URL=postgresql://postgres:sahay-local-only@127.0.0.1:5433/sahay?schema=public

# ====== AUTH: JWT ======
# 👉 ADD YOUR OWN: any long random string (use `openssl rand -base64 48`)
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ====== AI/ML MICROSERVICE (Flask, separate service) ======
AI_SERVICE_URL=http://localhost:8000

# ====== SMS / IVR GATEWAY (optional, for SAHAY fallback) ======
# 👉 ADD YOUR OWN: Exotel / Gupshup / Twilio credentials
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_SENDER_ID=SAHAY

# ====== MAPS ======
# 👉 ADD YOUR OWN: Google Maps / MapMyIndia key (used by frontend, listed here for reference)
MAPS_API_KEY=

# ====== PAYMENTS (optional, for B2C transparent trip fee) ======
# 👉 ADD YOUR OWN: Razorpay keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional server-side Gemini explanations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Maximum wait per background Gemini request, in milliseconds
GEMINI_OPERATION_TIMEOUT_MS=5000

# Optional OSRM-compatible server (defaults to the public demonstration service)
OSRM_URL=https://router.project-osrm.org
# TEST_DATABASE_URL may select a separate local database with a name ending in _test.

# Sahay RESCUE (optional; backend only; synthetic cases only)
MARITIME_ENABLED=false
MARITIME_API_KEY=
MARITIME_AGENT_ID=
MARITIME_API_BASE_URL=https://api.maritime.sh
MARITIME_TIMEOUT_MS=15000
MARITIME_REQUESTS_PER_MINUTE=6
MARITIME_POLL_MS=5000
MARITIME_MAX_ATTEMPTS=5
RESCUE_OFFER_TIMEOUT_MS=120000
RESCUE_REJECTION_COUNT=3
RESCUE_REJECTION_WINDOW_MS=300000
RESCUE_REFERRAL_TIMEOUT_MS=120000
RESCUE_ETA_INCREASE_MINUTES=5
RESCUE_GPS_STALE_MS=90000
RESCUE_HANDOFF_DELAY_MS=300000
RESCUE_SIMULATION_CONTROLS=false
