VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# 👉 ADD YOUR OWN: Google OAuth Client ID (same project as backend's GOOGLE_CLIENT_ID)
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 👉 ADD YOUR OWN (optional): Google Maps JS API key, to replace the built-in
# lightweight coverage/fleet panels with a real interactive map.
# https://console.cloud.google.com/google/maps-apis/credentials
VITE_MAPS_API_KEY=
