# ====== SERVER ======
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ====== DATABASE (PostgreSQL) ======
DATABASE_URL=postgresql://postgres:jeevansetu-local-only@127.0.0.1:5433/jeevansetu?schema=public

# ====== AUTH: JWT ======
# 👉 ADD YOUR OWN: any long random string (use `openssl rand -base64 48`)
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ====== AUTH: GOOGLE OAUTH ======
# 👉 ADD YOUR OWN: from https://console.cloud.google.com/apis/credentials
# Create an "OAuth Client ID" (type: Web application)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ====== AI/ML MICROSERVICE (Flask, separate service) ======
AI_SERVICE_URL=http://localhost:8000

# ====== SMS / IVR GATEWAY (optional, for JSOS fallback) ======
# 👉 ADD YOUR OWN: Exotel / Gupshup / Twilio credentials
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_SENDER_ID=JSOS

# ====== MAPS ======
# 👉 ADD YOUR OWN: Google Maps / MapMyIndia key (used by frontend, listed here for reference)
MAPS_API_KEY=

# ====== PAYMENTS (optional, for B2C transparent trip fee) ======
# 👉 ADD YOUR OWN: Razorpay keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
